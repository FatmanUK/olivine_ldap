# The golden oracle: OpenLDAP's own slapd, built from the
# pinned submodule and reachable over TCP.
#
# Rootless by construction — no USER root beyond the build, no
# capabilities, and slapd listens on an unprivileged port.
#
# The source is COPYed in rather than cloned, so the oracle is
# always the submodule's exact commit and never a moving
# upstream.
FROM docker.io/library/debian:bookworm-slim AS build

RUN apt-get update && apt-get install -y --no-install-recommends \
	build-essential \
	libssl-dev \
	libltdl-dev \
	libsasl2-dev \
	groff-base \
	&& rm -rf /var/lib/apt/lists/*

COPY src /usr/src/openldap
WORKDIR /usr/src/openldap

# --disable-bdb/--disable-hdb: Berkeley DB is gone from
# bookworm and Olivine uses Postgres anyway. back-mdb is
# bundled, so the oracle has a working database without it.
#
# Cyrus SASL is in, because a SASL bind cannot be compared without
# it: built --without-cyrus-sasl, neither slapd nor ldapwhoami can
# do one at all, and the root DSE advertises no mechanism. The
# GSSAPI plugin comes with it in the runtime stage below.
RUN ./configure \
	--prefix=/opt/openldap \
	--enable-slapd \
	--enable-mdb \
	--disable-bdb \
	--disable-hdb \
	--with-tls=openssl \
	--with-cyrus-sasl \
	--enable-spasswd \
	&& make depend \
	&& make \
	&& make install

FROM docker.io/library/debian:bookworm-slim

# libsasl2-modules carries PLAIN and the rest; the gssapi module
# and the Kerberos clients are for comparing a GSSAPI bind, which
# needs a KDC to issue tickets.
RUN apt-get update && apt-get install -y --no-install-recommends \
	libssl3 libltdl7 \
	libsasl2-2 libsasl2-modules \
	libsasl2-modules-gssapi-mit \
	krb5-user krb5-kdc krb5-admin-server \
	&& rm -rf /var/lib/apt/lists/*

COPY --from=build /opt/openldap /opt/openldap

# An unprivileged user, and a port above 1024 to match.
RUN useradd --system --create-home --uid 10001 olivine

# back-mdb needs somewhere to write. It lives inside the
# container so no host directory has to be made writable by
# the container's uid, which rootless Podman maps to a subuid.
RUN mkdir -p /data && chown olivine:olivine /data

USER olivine
ENV PATH=/opt/openldap/bin:/opt/openldap/sbin:$PATH

EXPOSE 10636

# Arguments come from the harness, so the debug level and the
# listener URL are not baked in.
ENTRYPOINT ["/opt/openldap/libexec/slapd"]
